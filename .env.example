# Copy to .env (git-ignored, unreadable to agents). Scripts read it themselves; values are never printed.
# Azure OpenAI resource used by the understanding layer (GPT-6 Astra).
AOAI_ENDPOINT=https://<resource>.openai.azure.com
AOAI_API_KEY=
# GPT-6 Astra deployment for the understanding layer (src/so101_demo/understanding/astra.py):
# the name shown under "Deployments" in Azure AI Foundry. Called through the
# Responses API at {AOAI_ENDPOINT}/openai/v1/responses with this name as "model".
AOAI_ASTRA_DEPLOYMENT=
