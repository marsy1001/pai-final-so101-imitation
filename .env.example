# Copy to .env (git-ignored, unreadable to agents). Scripts read it themselves; values are never printed.
# Azure OpenAI resource shared by scripts/deck/gen-image.py and the understanding layer.
AOAI_ENDPOINT=https://<resource>.openai.azure.com
AOAI_API_KEY=
# deployment name used when a prompt file has no "model:" line (scripts/deck/gen-image.py)
AOAI_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst
# AOAI_API_VERSION=preview
# GPT-6 Astra deployment for the understanding layer (src/so101_demo/understanding/astra.py,
# Issue #22): the name shown under "Deployments" in Azure AI Foundry. Called through the
# Responses API at {AOAI_ENDPOINT}/openai/v1/responses with this name as "model".
AOAI_ASTRA_DEPLOYMENT=
