# agmsg delivery hooks (machine-specific absolute paths; generated by scripts/setup.sh)
.claude/settings.local.json
.codex/hooks.json

# local secrets
.env
.env.local

# editor / OS
.DS_Store
*.swp

# local issues (state of the work, written by both agents; see scripts/issue.sh)
issues/

# python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/

# upstream simulation assets fetched by scripts/fetch-so101.sh (only the manifest is tracked)
assets/so101/*
!assets/so101/MANIFEST.sha256

# large local artifacts (videos over the commit limit, scratch output)
tmp/
